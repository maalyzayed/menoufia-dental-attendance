<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>عضو هيئة التدريس | الحضور</title><link rel="stylesheet" href="styles.css"><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script></head><body><header><nav class="nav"><div class="brand"><div class="logo">🦷</div><div>لوحة عضو هيئة التدريس<small id="welcome" style="display:block;font-weight:500"></small></div></div><button class="no-print" id="logout">تسجيل الخروج</button></nav></header><main><div id="message" class="notice hidden"></div><section class="card"><h2>إنشاء جلسة حضور جديدة</h2><p class="muted">ينشئ النظام رمز QR صالحًا لمدة قصيرة. يجب أن يكون الطالب مسجلًا بالمقرر في بياناته.</p><div class="row"><div class="field"><label for="course">اسم المقرر</label><input id="course" required placeholder="مثال: Oral Biology"></div><div class="field"><label for="sessionType">نوع الجلسة</label><select id="sessionType"><option value="lecture">محاضرة</option><option value="section">سكشن</option><option value="lab">عملي</option></select></div><div class="field"><label for="duration">صلاحية QR بالدقائق</label><select id="duration"><option value="2">دقيقتان</option><option value="5" selected>5 دقائق</option><option value="10">10 دقائق</option></select></div></div><button id="createBtn">إنشاء QR للجلسة</button><div id="qrArea" class="hidden" style="margin-top:20px"><div class="qrbox"><div id="qrcode"></div><p id="sessionInfo"></p></div><p class="muted">اعرضي الرمز داخل قاعة المحاضرة فقط. إغلاق الجلسة يتم من الزر أدناه.</p><div class="actions"><button id="closeBtn" class="danger">إنهاء الجلسة</button><button class="secondary" onclick="window.print()">طباعة QR</button></div></div></section><section class="card"><div class="topline"><h2>سجلات الجلسات الأخيرة</h2><button class="secondary no-print" id="refresh">تحديث</button></div><div class="table-wrap"><table><thead><tr><th>المقرر</th><th>النوع</th><th>تاريخ الإنشاء</th><th>الحالة</th><th>الحضور</th></tr></thead><tbody id="sessions"><tr><td colspan="5">جارٍ التحميل...</td></tr></tbody></table></div></section></main><footer>كلية طب الأسنان - جامعة المنوفية</footer><script type="module">
import {requireRole,logout,$,say,setBusy,collection,getDocs,query,where,orderBy,httpsCallable,db,escapeHtml} from './shared.js';let profile,activeSession=null;
$('logout').onclick=logout;$('refresh').onclick=loadSessions;
requireRole(['doctor','admin'],async(u,p)=>{profile=p;$('welcome').textContent=p.displayName||p.name||u.email;await loadSessions()});
$('createBtn').onclick=async()=>{const course=$('course').value.trim();if(!course){say('أدخلي اسم المقرر أولًا.','error');return}const b=$('createBtn');setBusy(b,true);try{const fn=httpsCallable((await import('./shared.js')).functions,'createAttendanceSession');const res=await fn({course,sessionType:$('sessionType').value,durationMinutes:Number($('duration').value)});activeSession=res.data.sessionId;$('qrcode').innerHTML='';new QRCode($('qrcode'),{text:JSON.stringify({sessionId:activeSession}),width:230,height:230,colorDark:'#173b63',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M});$('sessionInfo').textContent='الجلسة: '+activeSession+' · تنتهي: '+new Date(res.data.expiresAt).toLocaleTimeString('ar-EG');$('qrArea').classList.remove('hidden');say('تم إنشاء جلسة الحضور.','success');await loadSessions()}catch(e){console.error(e);say(e.message||'تعذر إنشاء الجلسة. تأكدي من نشر Cloud Functions وصلاحيات الحساب.','error')}finally{setBusy(b,false)}};
$('closeBtn').onclick=async()=>{if(!activeSession)return;try{const fn=httpsCallable((await import('./shared.js')).functions,'closeAttendanceSession');await fn({sessionId:activeSession});say('تم إنهاء الجلسة.','success');$('qrArea').classList.add('hidden');activeSession=null;await loadSessions()}catch(e){say(e.message||'تعذر إنهاء الجلسة.','error')}};
async function loadSessions(){try{const q=query(collection(db,'sessions'),where('createdBy','==',profile.uid),orderBy('createdAt','desc'));const snap=await getDocs(q);$('sessions').innerHTML=snap.docs.slice(0,30).map(d=>{const x=d.data();return `<tr><td>${escapeHtml(x.course)}</td><td>${escapeHtml(x.sessionType)}</td><td>${x.createdAt?.toDate?.().toLocaleString('ar-EG')||'—'}</td><td>${x.status==='open'?'مفتوحة':'منتهية'}</td><td>${x.attendanceCount||0}</td></tr>`}).join('')||'<tr><td colspan="5">لا توجد جلسات بعد.</td></tr>'}catch(e){console.error(e);$('sessions').innerHTML='<tr><td colspan="5">تعذر تحميل الجلسات. راجعي قواعد Firestore والفهارس.</td></tr>'}}
</script></body></html>
