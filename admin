<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>الإدارة | الحضور والغياب</title><link rel="stylesheet" href="styles.css"><script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script></head><body><header><nav class="nav"><div class="brand"><div class="logo">🦷</div><div>لوحة الإدارة<small style="display:block;font-weight:500">كلية طب الأسنان - جامعة المنوفية</small></div></div><button id="logout" class="no-print">تسجيل الخروج</button></nav></header><main><div id="message" class="notice hidden"></div><section class="grid"><div class="card"><div class="card-icon">👥</div><h3>الحسابات</h3><div class="metric" id="userCount">—</div></div><div class="card"><div class="card-icon">🗓️</div><h3>الجلسات</h3><div class="metric" id="sessionCount">—</div></div><div class="card"><div class="card-icon">✅</div><h3>سجلات الحضور</h3><div class="metric" id="attendanceCount">—</div></div></section><section class="card"><h2>إنشاء حساب طالب أو عضو هيئة تدريس</h2><p class="muted">ينشئ هذا النموذج حساب Authentication وملف صلاحيات Firestore عبر Cloud Function آمنة. يجب تغيير كلمة المرور المؤقتة عند أول دخول ضمن سياسة المؤسسة.</p><form id="userForm"><div class="row"><div class="field"><label>الاسم الكامل</label><input id="fullName" required></div><div class="field"><label>البريد الإلكتروني</label><input id="newEmail" type="email" required></div><div class="field"><label>كلمة مرور مؤقتة (8 أحرف على الأقل)</label><input id="newPassword" type="password" minlength="8" required></div></div><div class="row"><div class="field"><label>نوع الحساب</label><select id="newRole"><option value="student">طالب</option><option value="doctor">عضو هيئة تدريس</option><option value="admin">إدارة</option></select></div><div class="field"><label>الكود الجامعي / الوظيفي</label><input id="code"></div><div class="field"><label>الفرقة الدراسية (للطلاب)</label><select id="year"><option value="">غير محدد</option><option>الأولى</option><option>الثانية</option><option>الثالثة</option><option>الرابعة</option><option>الخامسة</option><option>الامتياز</option></select></div></div><div class="field"><label>المقررات المسجل بها الطالب (أسماء مفصولة بفاصلة إنجليزية ,)</label><input id="courses" placeholder="Oral Biology, Operative Dentistry"></div><button id="createUserBtn">إنشاء الحساب</button></form></section><section class="card"><div class="topline"><h2>تقرير الحضور العام</h2><div class="actions no-print"><button id="refresh">تحديث البيانات</button><button id="export">تصدير Excel</button><button class="secondary" onclick="window.print()">طباعة التقرير</button></div></div><div class="row"><div class="field"><label>تصفية حسب المقرر</label><input id="filterCourse" placeholder="اتركيه فارغًا لعرض الكل"></div><div class="field"><label>تصفية حسب الكود / اسم الطالب</label><input id="filterStudent" placeholder="اسم أو كود أو بريد"></div></div><div class="table-wrap"><table><thead><tr><th>اسم الطالب</th><th>الكود</th><th>المقرر</th><th>نوع الجلسة</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody id="rows"><tr><td colspan="6">جارٍ التحميل...</td></tr></tbody></table></div></section></main><footer>كلية طب الأسنان - جامعة المنوفية</footer><script type="module">
import {requireRole,logout,$,say,setBusy,collection,getDocs,query,orderBy,httpsCallable,db,escapeHtml} from './shared.js';let allRows=[],allUsers=[],allSessions=[];$('logout').onclick=logout;$('refresh').onclick=loadData;$('filterCourse').oninput=render;$('filterStudent').oninput=render;
requireRole(['admin'],async()=>loadData());
$('userForm').onsubmit=async e=>{e.preventDefault();const b=$('createUserBtn');setBusy(b,true,'جارٍ إنشاء الحساب...');try{const fn=httpsCallable((await import('./shared.js')).functions,'createManagedUser');const result=await fn({name:$('fullName').value.trim(),email:$('newEmail').value.trim(),password:$('newPassword').value,role:$('newRole').value,code:$('code').value.trim(),year:$('year').value,courses:$('courses').value.split(',').map(x=>x.trim()).filter(Boolean)});say('تم إنشاء الحساب: '+result.data.email,'success');$('userForm').reset();await loadData()}catch(e){console.error(e);say(e.message||'تعذر إنشاء الحساب.','error')}finally{setBusy(b,false)}};
async function loadData(){try{const [us,se,at]=await Promise.all([getDocs(collection(db,'users')),getDocs(query(collection(db,'sessions'),orderBy('createdAt','desc'))),getDocs(query(collection(db,'attendance'),orderBy('createdAt','desc')))]);allUsers=us.docs.map(d=>({uid:d.id,...d.data()}));allSessions=se.docs.map(d=>({id:d.id,...d.data()}));allRows=at.docs.map(d=>({id:d.id,...d.data()}));$('userCount').textContent=allUsers.length;$('sessionCount').textContent=allSessions.length;$('attendanceCount').textContent=allRows.length;render()}catch(e){console.error(e);say('تعذر تحميل التقارير. تحققي من قواعد Firestore والفهارس.','error')}}
function render(){const course=$('filterCourse').value.trim().toLowerCase(),person=$('filterStudent').value.trim().toLowerCase();const users=new Map(allUsers.map(u=>[u.uid,u]));const rows=allRows.filter(r=>(!course||(r.course||'').toLowerCase().includes(course))&&(!person||((users.get(r.studentId)?.name||'')+' '+(users.get(r.studentId)?.code||'')+' '+(users.get(r.studentId)?.email||'')).toLowerCase().includes(person)));$('rows').innerHTML=rows.slice(0,2000).map(r=>{const u=users.get(r.studentId)||{};return `<tr><td>${escapeHtml(u.name||u.displayName||u.email||'—')}</td><td>${escapeHtml(u.code||'—')}</td><td>${escapeHtml(r.course||'—')}</td><td>${escapeHtml(r.sessionType||'—')}</td><td>${r.createdAt?.toDate?.().toLocaleString('ar-EG')||'—'}</td><td>${escapeHtml(r.status||'حاضر')}</td></tr>`}).join('')||'<tr><td colspan="6">لا توجد نتائج.</td></tr>'}
$('export').onclick=()=>{const course=$('filterCourse').value.trim().toLowerCase(),person=$('filterStudent').value.trim().toLowerCase(),users=new Map(allUsers.map(u=>[u.uid,u]));const filtered=allRows.filter(r=>{const u=users.get(r.studentId)||{};return (!course||(r.course||'').toLowerCase().includes(course))&&(!person||((u.name||'')+' '+(u.code||'')+' '+(u.email||'')).toLowerCase().includes(person))});const data=[['اسم الطالب','البريد الإلكتروني','الكود','المقرر','نوع الجلسة','التاريخ','الحالة'],...filtered.map(r=>{const u=users.get(r.studentId)||{};return [u.name||u.displayName||'',u.email||'',u.code||'',r.course||'',r.sessionType||'',r.createdAt?.toDate?.().toLocaleString('ar-EG')||'',r.status||'حاضر']})];const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(data),'تقرير الحضور');XLSX.writeFile(wb,'menoufia-attendance-report.xlsx')};
</script></body></html>
