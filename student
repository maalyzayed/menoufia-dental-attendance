<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>بوابة الطالب | الحضور</title><link rel="stylesheet" href="styles.css"><script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script><script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script></head><body><header><nav class="nav"><div class="brand"><div class="logo">🦷</div><div>بوابة الطالب<small id="welcome" style="display:block;font-weight:500"></small></div></div><button id="logout" class="no-print">تسجيل الخروج</button></nav></header><main><div id="message" class="notice hidden"></div><section class="grid"><div class="card"><div class="card-icon">📚</div><h3>المقررات المسجلة</h3><div class="metric" id="courseCount">—</div></div><div class="card"><div class="card-icon">✅</div><h3>مرات الحضور</h3><div class="metric" id="presentCount">—</div></div><div class="card"><div class="card-icon">📈</div><h3>نسبة الحضور</h3><div class="metric" id="percentage">—</div></div></section><section class="card"><h2>تسجيل الحضور باستخدام QR</h2><p class="muted">اسمحي للمتصفح باستخدام الكاميرا، ثم امسحي رمز الجلسة الذي يعرضه عضو هيئة التدريس. يلزم فتح الموقع عبر HTTPS.</p><div class="actions no-print"><button id="startScan">تشغيل الكاميرا</button><button id="stopScan" class="secondary" disabled>إيقاف الكاميرا</button></div><div id="reader"></div></section><section class="card"><div class="topline"><h2>سجل الحضور والغياب</h2><div class="actions no-print"><button id="export">تصدير Excel</button><button class="secondary" onclick="window.print()">طباعة</button></div></div><div class="table-wrap"><table id="records"><thead><tr><th>المقرر</th><th>نوع الجلسة</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody id="recordRows"><tr><td colspan="4">جارٍ التحميل...</td></tr></tbody></table></div></section></main><footer>كلية طب الأسنان - جامعة المنوفية</footer><script type="module">
import {requireRole,logout,$,say,collection,getDocs,query,where,orderBy,httpsCallable,db,escapeHtml} from './shared.js';let user,profile,scanner,records=[];$('logout').onclick=logout;
requireRole(['student'],async(u,p)=>{user=u;profile=p;$('welcome').textContent=p.displayName||p.name||p.studentCode||u.email;await loadRecords()});
$('startScan').onclick=async()=>{try{scanner=new Html5Qrcode('reader');await scanner.start({facingMode:'environment'},{fps:10,qrbox:{width:240,height:240}},async decoded=>{try{await scanner.stop();$('stopScan').disabled=true;const data=JSON.parse(decoded);if(!data.sessionId)throw new Error('رمز QR غير صالح.');const fn=httpsCallable((await import('./shared.js')).functions,'checkInAttendance');const res=await fn({sessionId:data.sessionId});say(res.data.message||'تم تسجيل الحضور بنجاح.','success');await loadRecords()}catch(e){say(e.message||'تعذر تسجيل الحضور.','error')}},()=>{});$('stopScan').disabled=false;say('وجهي الكاميرا نحو QR المعروض في المحاضرة.','notice')}catch(e){console.error(e);say('تعذر تشغيل الكاميرا. تأكدي من إذن الكاميرا وفتح الموقع عبر HTTPS.','error')}};
$('stopScan').onclick=async()=>{if(scanner&&scanner.isScanning)await scanner.stop();$('stopScan').disabled=true};
async function loadRecords(){try{const q=query(collection(db,'attendance'),where('studentId','==',user.uid),orderBy('createdAt','desc'));const snap=await getDocs(q);records=snap.docs.map(d=>({id:d.id,...d.data()}));$('recordRows').innerHTML=records.map(x=>`<tr><td>${escapeHtml(x.course||'—')}</td><td>${escapeHtml(x.sessionType||'—')}</td><td>${x.createdAt?.toDate?.().toLocaleString('ar-EG')||'—'}</td><td>${escapeHtml(x.status||'حاضر')}</td></tr>`).join('')||'<tr><td colspan="4">لا توجد سجلات حضور حتى الآن.</td></tr>';const courses=new Set(records.map(x=>x.course).filter(Boolean));$('courseCount').textContent=profile.courses?.length??courses.size;$('presentCount').textContent=records.filter(x=>x.status==='حاضر').length;$('percentage').textContent=records.length?Math.round(records.filter(x=>x.status==='حاضر').length/records.length*100)+'%':'—'}catch(e){console.error(e);say('تعذر تحميل سجل الحضور. قد تحتاجين إلى إنشاء فهرس Firestore للاستعلام.','error')}}
$('export').onclick=()=>{if(!records.length){say('لا توجد بيانات لتصديرها.','error');return}const rows=[['المقرر','نوع الجلسة','التاريخ','الحالة'],...records.map(x=>[x.course,x.sessionType,x.createdAt?.toDate?.().toLocaleString('ar-EG')||'',x.status])];const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'سجل الحضور');XLSX.writeFile(wb,'student-attendance.xlsx')};
</script></body></html>
